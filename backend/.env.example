# Copy to .env for local dev (never commit the real .env — it's gitignored).
# On Render, set these as environment variables in the service's dashboard instead.

# Supabase project settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The SERVICE_ROLE key (not the anon/public key) — it bypasses Row Level
# Security, which is required since only the backend talks to Supabase.
# Keep this secret; never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call the API from a browser —
# your Vercel frontend URL(s). Example:
# ALLOWED_ORIGINS=https://kpi-dashboard-tt.vercel.app
ALLOWED_ORIGINS=

# Render sets PORT automatically — only needed for local dev if you want a
# port other than 4000.
PORT=4000

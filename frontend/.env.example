# Copy to .env.local for local dev if you want to point at a deployed backend
# instead of the Vite dev proxy. On Vercel, set VITE_API_URL as a project
# environment variable instead — it must be set at build time (Vite bakes
# env vars in at build, not read at runtime).

# Full URL of the Render backend's API, including the /api suffix:
VITE_API_URL=https://tt-kpi-backend.onrender.com/api
